# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code local machine settings (launch.json is shared)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
.pytest_cache/

# Third-party inference repos, cloned per backend/README.md. Each carries its
# own .git, so the parent repo cannot track them anyway.
/backend/sam2/
/backend/TripoSR/
/backend/sam3/
/backend/ml-sharp/

# Model weights (~1.2 GB), fetched by backend/download_models.py
/backend/checkpoints/

# Local scratch images used for manual pipeline runs
/*.webp

# Local reconstruction datasets, checkpoints, exports, and service logs.
# These can contain source videos and multi-gigabyte Gaussian artifacts.
/.artifacts/
/service-logs/

# usd export (see scripts/usd-export/README.md)
/scripts/usd-export/.venv
/scripts/usd-export/__pycache__
/scripts/usd-export/.pytest-tmp
/scripts/usd-export/.pytest_cache

# Generated worlds are local data, not source. They are large (hundreds of MB
# each) and reconstruct the room in the source photo, so they are kept out of
# the repository. The app renders a create-world screen when this is empty.
/public/worlds/*
!/public/worlds/.gitkeep

# One exception: a trimmed sample world so a fresh clone has something to walk
# around in without a GPU or an API key. It carries the 100k and 500k LODs and
# the source photo, but not full_res (28 MB).
!/public/worlds/demo-office/
!/public/worlds/demo-office/**

# ... but not the parts of its export that regenerate. `pipeline.py` writes
# these, and two of the three are cheap to make again: the .usdz rebuilds from
# the tracked GLB in about a second, and the driving overlay needs Isaac Sim to
# mean anything at all. The navmap trio stays, and earns its few kilobytes --
# with it in the tree a fresh clone can run `check_navmap.py` and the nav2 check
# against a real map, with no GPU, no Isaac Sim and no API key.
/public/worlds/demo-office/export/*.usdz
/public/worlds/demo-office/export/*-navigate.*
# The viewpoint graph is derived from the tracked map in about a second, and
# `test_vlngraph.py` rebuilds it from that map and asserts on what comes out.
# Committing it as well would put a second copy of those numbers in the tree
# with nothing comparing them, which is how the nav2 figures went stale.
/public/worlds/demo-office/export/*-vlngraph.*

# `build_collider.py` keeps the collider it is about to replace, so rebuilding a
# generative world is reversible. For a tracked world that copy is redundant --
# the previous version is already in the history.
*.glb.orig
scripts/isaac-sim/imageworld.omap.generated.kit
